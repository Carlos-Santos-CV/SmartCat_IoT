# ==========================================
# SmartCat IoT - Ambiente de Produção (Deploy)
# ==========================================
# Este arquivo é para deploy na VM do Google Cloud
# Copie para .env e preencha com valores reais

# --- Banco de Dados ---
# PostgreSQL via Docker Compose (rede interna)
DATABASE_URL=postgresql://smartcat_user:smartcat_password@db:5432/smartcat_db

# --- Broker MQTT ---
# Mosquitto local via Docker Compose (rede interna, mais seguro)
MQTT_BROKER=mosquitto
MQTT_PORT=1883

# --- Notificações Web Push (VAPID) ---
# USE AS MESMAS CHAVES DO AMBIENTE DE DESENVOLVIMENTO
# Isso permite que o service worker continue funcionando
# Execute: python ../scripts/generate_vapid_keys.py (uma vez só, use em ambos)

VAPID_PUBLIC_KEY=<COLE_A_CHAVE_PUBLICA_GERADA>
VAPID_PRIVATE_KEY=<COLE_A_CHAVE_PRIVADA_GERADA>
VAPID_CLAIM_EMAIL=mailto:admin@smartcat.com

# --- Configurações de Segurança ---
# Senhas do banco (mude em produção real!)
POSTGRES_USER=smartcat_user
POSTGRES_PASSWORD=smartcat_password
POSTGRES_DB=smartcat_db

# --- Domínio (para Caddy/HTTPS) ---
# Substitua pelo seu domínio real ou IP público da VM
# DOMAIN=seu-dominio.com
# Ou use IP: DOMAIN=34.123.45.67
