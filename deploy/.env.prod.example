# =============================================================
# deploy/.env.prod — usado em PRODUÇÃO
# (docker-compose.yml + docker-compose.prod.yml)
# =============================================================
# Copie este arquivo para "deploy/.env.prod" na VM e preencha com
# valores reais. NUNCA commite o .env.prod de verdade no git.
#
#   cp deploy/.env.prod.example deploy/.env.prod
#   chmod 600 deploy/.env.prod
#
# Como usar na hora de subir:
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml \
#     --env-file deploy/.env.prod up -d --build

# ---- Postgres ----
# Use uma senha forte de verdade aqui — este banco fica acessível
# pela rede interna do compose para web/worker; gere com, por
# exemplo: openssl rand -base64 24
POSTGRES_USER=smartcat_user
POSTGRES_PASSWORD=troque_por_uma_senha_forte_aqui
POSTGRES_DB=smartcat_db

# ---- Web Push (VAPID) ----
# Obrigatório em produção para as notificações de alerta funcionarem.
# Gere rodando (uma vez, com as deps do backend instaladas):
#   python scripts/generate_vapid_keys.py
# e cole a chave pública/privada geradas abaixo.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# E-mail de contato exigido pelo protocolo Web Push (VAPID claim).
# Troque pelo seu e-mail real de contato/administração do serviço.
VAPID_CLAIM_EMAIL=mailto:seuemail@dominio.com
