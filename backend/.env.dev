# ==========================================
# SmartCat IoT - Ambiente de Desenvolvimento
# ==========================================
# Copie este arquivo para .env e preencha as chaves VAPID
# Gere as chaves com: python ../scripts/generate_vapid_keys.py

# --- Banco de Dados ---
# Opção 1: SQLite (mais simples para dev, não precisa Docker)
DATABASE_URL=sqlite:///./smartcat.db

# Opção 2: PostgreSQL via Docker (descomente se quiser usar)
# DATABASE_URL=postgresql://smartcat_user:smartcat_password@localhost:5432/smartcat_db

# --- Broker MQTT ---
# Usa broker público (não precisa subir Mosquitto localmente)
MQTT_BROKER=broker.hivemq.com
MQTT_PORT=1883

# Se quiser usar broker local via Docker, use:
# MQTT_BROKER=mosquitto
# MQTT_PORT=1883

# --- Notificações Web Push (VAPID) ---
# OBRIGATÓRIO: Gere suas chaves com o script abaixo
# Execute: python ../scripts/generate_vapid_keys.py
# Copie os valores gerados para cá:

VAPID_PUBLIC_KEY=hrU49QD-MNzN90qDNURyijM-lWYwMCYYUxexW6kAEtCpHSCTQx8at3u7hN3GxG4cccbRKx7WF281AvdmaS4Ufw
VAPID_PRIVATE_KEY=i34YxjQD6bgw5sXfdwxUC4I0n2aiR1cE4L3yemDK6ps
VAPID_CLAIM_EMAIL=mailto:dev@smartcat.local

# --- Configurações Opcionais ---
# Janela de deduplicação de alertas (em horas)
# ALERT_DEDUPLICATION_WINDOW_HOURS=2

# Limites de saúde (em horas/segundos)
# JEJUM_MAXIMO_HORAS=24
# CAIXA_MAXIMO_SEGUNDOS=300
